# ---------------------------------------------------------------------------
# Preema Aviation — environment variables
# Copy to .env.local for development. Set the same keys in Vercel for production.
# Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase project (Project Settings -> API). The publishable/anon key is safe in the browser;
# Row Level Security protects all private data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only secret that authorises the website to submit inquiries.
# Generate with `npm run gen:secret`, then register it ONCE in the Supabase SQL editor:
#   select private.set_app_secret('inquiry_submit', '<the same value>');
INQUIRY_SUBMIT_SECRET=

# Server-only salt used to hash visitor IP addresses for rate limiting (any long random string).
IP_HASH_SALT=

# Optional: staff e-mail notifications for new inquiries via Resend (https://resend.com).
# Recipients and the on/off switch are managed in /admin/settings.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Preema Aviation Website <notifications@your-verified-domain.com>"

# Show packages flagged as demo content (development only). Keep false in production.
NEXT_PUBLIC_SHOW_DEMO_CONTENT=false

# Optional: allow search engines to index the site. Keep false on preview/staging deployments.
NEXT_PUBLIC_ALLOW_INDEXING=false
